---
import { getCollection } from "astro:content";
import Shell from "../layouts/Shell.astro";

const posts = (await getCollection("sciezki")).sort((a, b) => +b.data.pubDate - +a.data.pubDate).slice(0, 6);
const lists = [
  { id: "PLJygS-sIE3ybt9rMcDz8yErBp-JDE5Ykn", title: "Legendary 1990's Hip-Hop" },
  { id: "PLmXxqSJJq-yXvmRMuHu7vd2XdJEUgsr33", title: "90s Hip Hop Hits" },
  { id: "PL4G14zsHQYcUAsIcKaxxVZEPiat7JA6Cp", title: "90s Underground" },
];

const dzialy = [...new Set(
  (await getCollection("sciezki")).map((post) => post.data.category).filter(Boolean)
)].map((name) => ({
  name,
  slug: String(name).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/ł/g, "l").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
}));
---
<Shell
  title="RESPECT | rap, mur, lata 90"
  description="Amerykański rap lat 90, graffiti i playlisty z klasykami. Redakcja RESPECT."
  image="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=1200&h=630&q=80"
>
  <section class="hero-respect">
    <img
      src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=1600&h=1200&q=80"
      alt="Scena i głośnik. Motyw bitu, nie konkretny klub."
      width="1600"
      height="1200"
      fetchpriority="high"
    />
    <div class="mx-auto flex h-full max-w-6xl flex-col justify-end px-5 py-16 md:justify-center md:py-24">
      <p class="text-xs uppercase tracking-[0.35em] text-[var(--red)]">RESPECT · Warszawa</p>
      <h1 class="mt-3 font-display text-7xl leading-none text-[var(--gold)] md:text-8xl">RESPECT</h1>
      <p class="mt-6 max-w-xl text-lg text-[var(--muted)]">
        Bit z lat 90, mur i kaseta. Klasyki Ameryki opisane tak, jak się ich słucha, nie jak hasła z encyklopedii.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="bg-[var(--gold)] px-5 py-3 text-sm font-medium text-black" href="/sciezki/">Czytaj ścieżki</a>
        <a class="border border-[var(--line)] px-5 py-3 text-sm" href="/#play">Włącz play</a>
      </div>
    </div>
  </section>

  <section id="play" class="mx-auto max-w-6xl px-5 py-14">
    <h2 class="font-display text-4xl text-[var(--gold)]">Klasyki Ameryki, lata 90</h2>
    <p class="mt-2 max-w-2xl text-sm text-[var(--muted)]">
      Trzy zestawy z YouTube: przeboje dekady, dłuższa składanka i underground. Pod spodem godzinny miks z katalogu.
    </p>
    <div class="mt-6 grid gap-4 lg:grid-cols-3">
      {lists.map((list) => (
        <figure class="border border-[var(--line)] bg-black p-3">
          <iframe
            class="aspect-video w-full"
            src={`https://www.youtube-nocookie.com/embed/videoseries?list=${list.id}`}
            title={list.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
          <figcaption class="mt-2 text-sm">{list.title}</figcaption>
        </figure>
      ))}
    </div>
    <figure class="mt-4 border border-[var(--red)]/50 p-3">
      <iframe
        class="aspect-video w-full"
        src="https://www.youtube-nocookie.com/embed/wxrAJuwGB08"
        title="Classic 90s Hip-Hop Mix"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
      <figcaption class="mt-2 text-sm">Godzinny miks klasyków, Urban Legends</figcaption>
    </figure>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-10">
    <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[var(--line-soft)] pb-4">
      <h2 class="font-display text-4xl">Świeże ścieżki</h2>
      <a class="text-sm underline-offset-2 hover:underline" href="/sciezki/">Całe archiwum</a>
    </div>
    <ul class="mt-2">
      {posts.map((post) => (
        <li class="border-b border-[var(--line-soft)]">
          <a class="block py-5 hover:text-[var(--gold)]" href={`/sciezki/${post.slug}/`}>
            <span class="text-xs uppercase tracking-widest text-[var(--red)]">{post.data.category}</span>
            <span class="mt-2 block font-display text-3xl leading-tight">{post.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-5 py-12 md:grid-cols-2">
    <a class="border border-[var(--line)] bg-[var(--bg-2)] p-6" href="/slownik/">
      <p class="text-xs uppercase tracking-[0.2em] opacity-60">Narzędzie</p>
      <h2 class="mt-2 font-display text-3xl text-[var(--gold)]">Słownik bitu</h2>
      <p class="mt-3 text-sm leading-relaxed opacity-75">Boom bap, sample, cypher, throw-up. Hasła z tekstów RESPECT bez wykładu akademickiego.</p>
    </a>
    <a class="border border-[var(--line)] bg-[var(--bg-2)] p-6" href="/co-slychac/">
      <p class="text-xs uppercase tracking-[0.2em] opacity-60">Narzędzie</p>
      <h2 class="mt-2 font-display text-3xl text-[var(--gold)]">Co słychać w bicie</h2>
      <p class="mt-3 text-sm leading-relaxed opacity-75">Krótki quiz ucha: kick, snare, sample, cisza przed zwrotką.</p>
    </a>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] opacity-60">Działy</p>
        <h2 class="mt-1 font-display text-4xl">Sety</h2>
      </div>
      <a class="text-sm underline-offset-2 hover:underline" href="/sety/">Wszystkie działy</a>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      {dzialy.map((item) => (
        <a class="border border-[var(--line)] px-3 py-2 text-sm hover:border-[var(--gold)]" href={`/sety/${item.slug}/`}>{item.name}</a>
      ))}
    </div>
  </section>
</Shell>
