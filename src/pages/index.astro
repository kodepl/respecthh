---
import { getCollection } from "astro:content";
import Shell from "../layouts/Shell.astro";
const posts = (await getCollection("sciezki")).sort((a, b) => +b.data.pubDate - +a.data.pubDate).slice(0, 6);
const lists = [
  { id: "PLJygS-sIE3ybt9rMcDz8yErBp-JDE5Ykn", title: "Legendary 1990's Hip-Hop" },
  { id: "PLmXxqSJJq-yXvmRMuHu7vd2XdJEUgsr33", title: "90s Hip Hop Hits" },
  { id: "PL4G14zsHQYcUAsIcKaxxVZEPiat7JA6Cp", title: "90s Underground" },
];

const dzialy = [...new Set(posts.map((post) => post.data.category).filter(Boolean))].map((name) => ({
  name,
  slug: String(name).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/ł/g, "l").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
}));

---
<Shell title="RESPECT | rap, mur, lata 90" description="Amerykański rap lat 90, graffiti i playlisty z klasykami. Redakcja RESPECT.">
  <section class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-[1.2fr_0.8fr] md:items-end">
    <div>
      <p class="text-xs uppercase tracking-[0.35em] text-[#e23d2b]">Warszawa · Praga</p>
      <h1 class="mt-3 font-display text-7xl leading-none text-[#f2c14e] md:text-8xl">RESPECT</h1>
      <p class="mt-6 max-w-xl text-lg text-[#f3ead7]/80">Bit z lat 90, mur i kaseta. Klasyki Ameryki, opisane tak, jak się ich słucha, nie jak hasła z encyklopedii.</p>
    </div>
    <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=900&h=1100&q=80" alt="" class="h-80 w-full object-cover grayscale" />
  </section>
  <section id="play" class="mx-auto max-w-6xl px-5 pb-8">
    <h2 class="font-display text-4xl text-[#f2c14e]">Klasyki Ameryki, lata 90</h2>
    <p class="mt-2 max-w-2xl text-sm text-[#f3ead7]/70">Trzy zestawy: przeboje dekady, dłuższa składanka i underground. Pod spodem godzinny miks z katalogu.</p>
    <div class="mt-6 grid gap-4 lg:grid-cols-3">
      {lists.map((list) => (
        <figure class="border border-[#f2c14e]/30 bg-black p-3">
          <iframe class="aspect-video w-full" src={`https://www.youtube.com/embed/videoseries?list=${list.id}`} title={list.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          <figcaption class="mt-2 text-sm">{list.title}</figcaption>
        </figure>
      ))}
    </div>
    <figure class="mt-4 border border-[#e23d2b]/50 p-3">
      <iframe class="aspect-video w-full" src="https://www.youtube.com/embed/wxrAJuwGB08" title="Classic 90s Hip-Hop Mix" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
      <figcaption class="mt-2 text-sm">Godzinny miks klasyków, Urban Legends</figcaption>
    </figure>
  </section>
  <section class="mx-auto max-w-6xl px-5 py-10">
    <h2 class="font-display text-4xl">Świeże ścieżki</h2>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {posts.map((post) => (
        <li>
          <a class="block border border-[#f3ead7]/15 p-5 hover:border-[#f2c14e]" href={`/sciezki/${post.slug}/`}>
            <span class="text-xs uppercase tracking-widest text-[#e23d2b]">{post.data.category}</span>
            <span class="mt-2 block font-display text-3xl leading-tight">{post.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.22em] opacity-60">Działy</p>
        <h2 class="mt-1 font-display text-4xl">Sety</h2>
      </div>
      <a class="text-sm underline-offset-2 hover:underline" href="/sety/">Wszystkie działy</a>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      {dzialy.map((item) => (
        <a class="border border-[#f2c14e]/40 px-3 py-2 text-sm hover:opacity-80" href={`/sety/${item.slug}/`}>{item.name}</a>
      ))}
    </div>
  </section>

</Shell>
