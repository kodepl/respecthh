---
import Layout from "../layouts/Shell.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("sciezki")).sort((a, b) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const items = posts.map((post) => ({
  title: post.data.title,
  category: post.data.category || "",
  href: "/sciezki/" + post.slug + "/",
}));
---
<Layout title="Szukaj w bicie | RESPECT" description="Szukaj tekstów RESPECT po tytule i secie: miasto, sample, dekada.">
  <section class="mx-auto max-w-3xl px-5 py-14">
    <p class="text-xs uppercase tracking-[0.22em] opacity-60">Archiwum</p>
    <h1 class="mt-2 font-display text-4xl text-[var(--gold)]">Szukaj w bicie</h1>
    <p class="mt-3 opacity-70">Miasto, sample albo dekada.</p>
    <input id="q-respecthh" class="mt-6 w-full border border-[var(--line)] bg-black px-4 py-3 text-base text-[var(--ink)]" type="search" placeholder="Szukaj..." autocomplete="off" />
    <p id="n-respecthh" class="mt-3 text-sm opacity-60"></p>
    <ul id="list-respecthh" class="mt-6 divide-y divide-[var(--line-soft)]"></ul>
  </section>
</Layout>
<script define:vars={{ items, repo: "respecthh" }}>
  const input = document.getElementById("q-" + repo);
  const list = document.getElementById("list-" + repo);
  const note = document.getElementById("n-" + repo);
  const params = new URLSearchParams(location.search);
  if (input && params.get("q")) input.value = params.get("q");
  function draw() {
    const q = input.value.trim().toLowerCase();
    const found = items.filter((item) => (item.title + " " + item.category).toLowerCase().includes(q));
    note.textContent = found.length + " tekstów";
    list.innerHTML = found.slice(0, 40).map((item) =>
      '<li class="py-3"><a href="' + item.href + '"><span class="block text-xs uppercase tracking-wide opacity-60">' +
      item.category + '</span><span class="font-display text-2xl">' + item.title + "</span></a></li>"
    ).join("");
  }
  input.addEventListener("input", draw);
  draw();
</script>
