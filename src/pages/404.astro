    <div class="mt-8 flex flex-wrap gap-3 text-sm">
      <a class="bg-[var(--gold)] px-4 py-2 text-black" href="/">Start</a>
      <a class="border border-[var(--line)] px-4 py-2" href="/sciezki/">Ścieżki</a>
