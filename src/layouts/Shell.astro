---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description,
  image = "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=1200&h=630&q=80",
  type = "website",
  noindex = false,
} = Astro.props;

const origin = "https://www.respecthh.pl";
const path = Astro.url.pathname;
const canonical = new URL(path, origin).href;
const year = new Date().getFullYear();

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "RESPECT",
  url: origin + "/",
  inLanguage: "pl-PL",
  description: "Amerykański rap lat 90, mur, kaseta i playlisty z klasykami.",
  potentialAction: {
    "@type": "SearchAction",
    target: origin + "/w-bicie/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};

const nav = [
  { href: "/sciezki/", label: "Ścieżki" },
  { href: "/sety/", label: "Sety" },
  { href: "/#play", label: "Play" },
  { href: "/slownik/", label: "Słownik" },
  { href: "/co-slychac/", label: "Quiz" },
  { href: "/w-bicie/", label: "Szukaj" },
  { href: "/o-nas/", label: "Redakcja" },
];

function isCurrent(href: string) {
  if (href.startsWith("/#")) return false;
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href);
}
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0c0c0c" />
    <meta property="og:site_name" content="RESPECT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=IBM+Plex+Sans:wght@400;560;650&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script is:inline>if(location.hostname==="respecthh.pl")location.replace(location.href.replace("://","://www."));</script>
  </head>
  <body class="font-sans antialiased">
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <header class="border-b border-[var(--line)]">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-4">
        <a href="/" class="font-display text-4xl tracking-wide text-[var(--gold)]">RESPECT</a>
        <nav class="site-nav flex flex-wrap gap-x-4 gap-y-2 text-xs uppercase tracking-[0.18em]" aria-label="Główne">
          {nav.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="tresc">
      <slot />
    </main>
    <footer class="mt-20 border-t border-[var(--line-soft)]">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 md:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="font-display text-3xl text-[var(--gold)]">RESPECT</p>
          <p class="mt-3 max-w-md text-sm leading-relaxed opacity-70">
            Rap lat 90, mury, kasety. Amerykańskie klasyki opisane tak, jak się ich słucha, nie jak hasła z encyklopedii.
          </p>
          <p class="mt-4 text-xs opacity-50">© {year} RESPECT · Warszawa</p>
        </div>
        <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="Stopka">
          <a href="/sciezki/">Archiwum</a>
          <a href="/slownik/">Słownik</a>
          <a href="/co-slychac/">Quiz</a>
          <a href="/o-nas/">O nas</a>
          <a href="/kontakt/">Kontakt</a>
          <a href="/polityka-prywatnosci/">Prywatność</a>
        </nav>
      </div>
    </footer>
    <div id="pasek-respecthh" style="position:fixed;top:0;left:0;height:3px;width:0;background:#f2c14e;z-index:40;pointer-events:none"></div>
    <script>
      const pasek = document.getElementById("pasek-respecthh");
      addEventListener("scroll", () => {
        const node = document.documentElement;
        const max = node.scrollHeight - node.clientHeight;
        if (pasek) pasek.style.width = (max > 0 ? (node.scrollTop / max) * 100 : 0) + "%";
      }, { passive: true });
    </script>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"e3b9b825e1244edab957a1b79cc35582"}'></script>
    <script defer src="https://umami-pink-phi.vercel.app/script.js" data-website-id="e55dfdac-be4b-46d3-9de5-4eae0adbf14e" data-domains="respecthh.pl,www.respecthh.pl"></script>
  </body>
</html>
